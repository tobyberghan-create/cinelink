# Server-only. Set this in your host's environment variables (Vercel: Project → Settings → Environment Variables).
# Never prefix with VITE_ — that would ship it to the browser.
TMDB_API_KEY=your_tmdb_v3_key_here
# ...or instead the v4 "API Read Access Token":
# TMDB_READ_ACCESS_TOKEN=

# Optional, Phase 3. These ARE public and are built into the client bundle.
VITE_FEEDBACK_URL=https://tally.so/r/your-form-id
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
